# Copy to .env and adjust. Vite only exposes variables prefixed with VITE_,
# and everything here ends up in the browser bundle — never put a secret in it.

# Curriculum Designer agent. Runs on 8003 locally; use its deployed URL otherwise.
VITE_CURRICULUM_URL=http://localhost:8003

# Which lab this dashboard is showing.
VITE_LAB_ID=lab4
VITE_COURSE_ID=csc580
VITE_INSTRUCTOR_ID=instructor_1
