# Committed on purpose: used by `npm run dev` only (Vercel builds ignore it). These are public identifiers, not
# secrets: they end up in the browser either way. Never put an API key in a VITE_ variable.
# Microsoft sign-in with Cal Poly accounts; see docs/MICROSOFT_SIGN_IN.md. The app registration allows
# http://localhost:5173/redirect.html only, so run the UI on port 5173.
# To use the development sign-in form instead, put VITE_MS_CLIENT_ID= (empty) in .env.local.
VITE_MS_CLIENT_ID=340f7c35-1116-4e2e-af4a-0d27c36dfdd8
VITE_MS_TENANT_ID=1b0d02db-fc9e-4495-9537-1d379cca2ae7
VITE_ALLOWED_EMAIL_DOMAIN=calpoly.edu
VITE_MS_LOGIN_FLOW=redirect
